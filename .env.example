# RAZORPAY: Payment gateway credentials for puresupps.site
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# SMTP: Discount email sending (Nodemailer / PHP mail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your_app_password"

# APP_URL: Your production domain
APP_URL="https://www.puresupps.site"

# WORDPRESS: If using WordPress plugin, set these in WP admin instead
# These are only for standalone PHP hosting (cPanel / Hostinger)
